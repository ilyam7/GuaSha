<section class="section rich-text" style="text-align: {{ section.settings.text_align }};">
  <div class="container container--narrow">
    {%- if section.settings.eyebrow != blank -%}
      <p class="section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="rte">{{ section.settings.body }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    { "name": "Rich text" }
  ]
}
{% endschema %}
