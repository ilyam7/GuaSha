<div class="announcement-bar">
  <div class="container announcement-bar__inner">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="announcement-bar__message">
        {{ section.settings.message | escape }}
      </a>
    {% else %}
      <span class="announcement-bar__message">{{ section.settings.message | escape }}</span>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Free shipping on orders over $40 — happy tails guaranteed"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    { "name": "Announcement bar" }
  ]
}
{% endschema %}
