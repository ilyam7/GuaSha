<section class="section main-blog">
  <div class="container">
    <header class="section__header">
      <h1 class="section__heading">{{ blog.title }}</h1>
    </header>
    {%- paginate blog.articles by 12 -%}
      <ul class="article-grid" role="list">
        {%- for article in blog.articles -%}
          <li>
            <a href="{{ article.url }}" class="article-card">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title }}
              {%- endif -%}
              <h3>{{ article.title }}</h3>
              <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
