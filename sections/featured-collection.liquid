<section class="section featured-collection">
  <div class="container">
    <header class="section__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="section__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </header>

    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank and collection.products.size > 0 -%}
      <ul class="product-grid" role="list">
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.show_view_all -%}
        <div class="section__cta">
          <a class="btn btn--ghost" href="{{ collection.url }}">View all {{ collection.title | downcase }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <ul class="product-grid product-grid--placeholder" role="list">
        {%- for i in (1..section.settings.products_to_show) -%}
          <li>{% render 'product-card-placeholder', index: forloop.index %}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everyday essentials, loved by every tail" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Tried, tested, and approved by real pets and their humans." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"view all\" button", "default": true }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
