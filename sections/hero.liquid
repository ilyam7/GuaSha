<section
  class="hero hero--align-{{ section.settings.text_align }}{% if section.settings.image != blank %} hero--has-image{% endif %}"
  style="
    --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-min-height: {{ section.settings.min_height }}px;
  "
>
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '600,900,1200,1600,2000,2400',
          alt: section.settings.image.alt | default: section.settings.heading
      }}
    </div>
  {%- endif -%}

  <div class="hero__overlay"></div>

  <div class="container hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="hero__actions">
      {%- if section.settings.primary_label != blank -%}
        <a class="btn btn--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a class="btn btn--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pet accessories made simple"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything your pet needs, none of what they don't."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Thoughtfully chosen everyday essentials for dogs, cats, and small companions — built to last and priced fairly."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop bestsellers"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Browse all"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 320,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 560
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
