<section class="section main-cart">
  <div class="container">
    <header class="section__header">
      <h1 class="section__heading">{{ 'cart.title' | t }}</h1>
    </header>

    {%- if cart.item_count > 0 -%}
      {% form 'cart' %}
        <table class="cart-table">
          <thead>
            <tr>
              <th scope="col">Product</th>
              <th scope="col">{{ 'cart.quantity' | t }}</th>
              <th scope="col">Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <div class="cart-item">
                    {%- if item.image -%}
                      <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="80" loading="lazy">
                    {%- endif -%}
                    <div>
                      <a href="{{ item.url }}">{{ item.product.title }}</a>
                      {%- unless item.product.has_only_default_variant -%}
                        <p class="cart-item__variant">{{ item.variant.title }}</p>
                      {%- endunless -%}
                      <p class="cart-item__price">{{ item.final_price | money }}</p>
                    </div>
                  </div>
                </td>
                <td>
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    aria-label="{{ 'cart.quantity' | t }}"
                  >
                  <a href="{{ item.url_to_remove }}" class="cart-item__remove">{{ 'cart.remove' | t }}</a>
                </td>
                <td>{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart-summary">
          <p class="cart-summary__subtotal">
            <span>{{ 'cart.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money }}</strong>
          </p>
          <p class="cart-summary__note">{{ 'cart.shipping_note' | t }}</p>
          <div class="cart-summary__actions">
            <button type="submit" name="update" class="btn btn--ghost">Update</button>
            <button type="submit" name="checkout" class="btn btn--primary">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      {% endform %}
    {%- else -%}
      <div class="cart-empty">
        <p>{{ 'cart.empty' | t }}</p>
        <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
