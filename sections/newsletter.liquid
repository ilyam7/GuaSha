<section class="section newsletter">
  <div class="container container--narrow newsletter__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="section__description">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {% form 'customer', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="NewsletterEmail" class="visually-hidden">{{ 'general.newsletter.label' | t }}</label>
      <input
        type="email"
        id="NewsletterEmail"
        name="contact[email]"
        placeholder="{{ 'general.newsletter.placeholder' | t }}"
        required
      >
      <button type="submit" class="btn btn--primary">{{ 'general.newsletter.submit' | t }}</button>

      {%- if form.posted_successfully? -%}
        <p class="newsletter__success" role="status">{{ 'general.newsletter.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="newsletter__error" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Treats in your inbox" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Sign up for new arrivals, care guides, and 10% off your first order." }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
