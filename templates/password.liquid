<div class="container container--narrow" style="padding: 80px 24px; text-align:center;">
  <h1 class="section__heading">{{ shop.name }}</h1>
  <p>We're putting the finishing touches on something good. Drop your email to be the first to know when we open.</p>

  {% form 'storefront_password' %}
    <div class="form-row">
      <label for="Password">Password</label>
      <input type="password" id="Password" name="password" required>
    </div>
    <button type="submit" class="btn btn--primary">Enter</button>
  {% endform %}

  {% form 'customer', class: 'newsletter__form' %}
    <input type="hidden" name="contact[tags]" value="prospect, password page">
    <label for="PasswordEmail" class="visually-hidden">Email</label>
    <input type="email" id="PasswordEmail" name="contact[email]" placeholder="you@example.com" required>
    <button type="submit" class="btn btn--primary">Notify me</button>
  {% endform %}
</div>
