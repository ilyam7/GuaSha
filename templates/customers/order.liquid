<section class="section">
  <div class="container">
    <h1 class="section__heading">Order {{ order.name }}</h1>
    <p>Placed {{ order.created_at | date: '%b %-d, %Y' }} · Status: {{ order.financial_status_label }}</p>

    <table class="cart-table">
      <thead><tr><th>Product</th><th>Qty</th><th>Total</th></tr></thead>
      <tbody>
        {%- for line in order.line_items -%}
          <tr>
            <td>{{ line.title }}</td>
            <td>{{ line.quantity }}</td>
            <td>{{ line.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>

    <p style="margin-top:24px;"><strong>Total: {{ order.total_price | money }}</strong></p>
  </div>
</section>
