<section class="section">
  <div class="container container--narrow">
    <h1 class="section__heading" style="text-align:center;">{{ 'customer.register' | t }}</h1>
    {% form 'create_customer' %}
      {{ form.errors | default_errors }}
      <div class="form-row">
        <label for="FirstName">First name</label>
        <input type="text" name="customer[first_name]" id="FirstName">
      </div>
      <div class="form-row">
        <label for="LastName">Last name</label>
        <input type="text" name="customer[last_name]" id="LastName">
      </div>
      <div class="form-row">
        <label for="RegisterEmail">Email</label>
        <input type="email" name="customer[email]" id="RegisterEmail" required>
      </div>
      <div class="form-row">
        <label for="RegisterPassword">Password</label>
        <input type="password" name="customer[password]" id="RegisterPassword" required>
      </div>
      <button type="submit" class="btn btn--primary btn--block">Create account</button>
    {% endform %}
  </div>
</section>
