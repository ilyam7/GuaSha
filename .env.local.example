# ---------------------------------------------------------------
# STRIPE KEYS
# ---------------------------------------------------------------
# 1. Copy this file to `.env.local`
# 2. Replace the placeholder values below with YOUR Stripe keys.
#    - Get them at: https://dashboard.stripe.com/apikeys
#    - For testing, use the keys that start with `pk_test_` / `sk_test_`
#    - For production (live mode), use the keys that start with `pk_live_` / `sk_live_`
# 3. Restart the dev server after editing this file.
# ---------------------------------------------------------------

# Publishable key (safe to expose in the browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_PASTE_YOUR_PUBLISHABLE_KEY_HERE

# Secret key (server-side only — NEVER commit this to git)
STRIPE_SECRET_KEY=sk_test_PASTE_YOUR_SECRET_KEY_HERE

# Public site URL — used for Stripe redirect URLs.
# Local: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
